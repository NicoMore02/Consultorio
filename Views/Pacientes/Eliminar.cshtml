@model List<Models.Paciente>
@{
    ViewData["Title"] = "Eliminar paciente";
}

<div class="selection-page py-3">
    <div class="page-heading">
        <h1>Elegí un paciente para eliminar</h1>
        <p class="text-muted mb-0">Esta acción también elimina sus horarios y asistencias y no se puede deshacer.</p>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success" role="status">@mensaje</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Todavía no hay pacientes registrados.</div>
    }
    else
    {
        <div class="card selection-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Paciente</th>
                            <th>Modalidad</th>
                            <th class="text-end pe-3">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var paciente in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@paciente.nombre</td>
                            <td>@(paciente.por_o_mensual == Models.ModalidadDePago.Mensual ? "Mensual" : "Por sesión")</td>
                            <td class="text-end pe-3">
                                <form asp-action="Eliminar" asp-route-id="@paciente.idPaciente" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Seguro que querés eliminar este paciente y todos sus registros?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
